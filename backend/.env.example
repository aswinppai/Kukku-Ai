# Backend Environment Variables Placeholder
# Do not place real API keys here. Copy this file to .env and fill in values.

# AI Provider Keys
GEMINI_API_KEY=
SARVAM_API_KEY=

# Voice model selection. Defaults match these values when unset.
SARVAM_STT_PRIMARY_MODEL=saaras:v3
SARVAM_STT_FALLBACK_MODEL=saaras:v4
SARVAM_TTS_PRIMARY_MODEL=bulbul:v3
SARVAM_TTS_FALLBACK_MODEL=bulbul:v2
SARVAM_TTS_FALLBACK_SPEAKER=anushka

# Server Settings
HOST=127.0.0.1
PORT=8000
